{{define "page:main"}}
<header class="page-hero shell">
    <p class="eyebrow"><span></span> Privacy without fine-print games</p>
    <h1>Your data stays yours.</h1>
    <p>This page separates the iOS and Android apps from this website because they handle information differently. The apps are local-first; the website only receives information you choose to send through its forms.</p>
</header>

<div class="content-layout shell">
    <nav class="contents-nav" aria-label="Privacy page sections">
        <span>On this page</span>
        <a href="#app-data">Mobile apps</a>
        <a href="#backups">System backups</a>
        <a href="#csv">CSV sharing</a>
