{{define "base"}}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>{{template "page:title" .}}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#101725">
    <link rel="canonical" href="{{.CanonicalURL}}">
    <meta property="og:site_name" content="WeekScale">
    <meta property="og:url" content="{{.CanonicalURL}}">
    <meta property="og:image" content="{{.SocialImageURL}}">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="WeekScale: See the week, not the daily noise">
    <meta property="og:locale" content="en_US">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="{{.SocialImageURL}}">
    <meta name="twitter:image:alt" content="WeekScale: See the week, not the daily noise">
    {{block "page:meta" .}}{{end}}
    <link rel="icon" href="/static/img/weekscale-mark.svg?version={{.Version}}" type="image/svg+xml">
    <link rel="icon" href="/static/img/favicon-32.png?version={{.Version}}" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="/static/img/apple-touch-icon.png?version={{.Version}}">
    <link rel="manifest" href="/static/site.webmanifest?version={{.Version}}">
    <link rel="stylesheet" href="/static/css/main.css?version={{.Version}}">
</head>
<body itemscope itemtype="https://schema.org/WebSite">
    <meta itemprop="name" content="WeekScale">
    <meta itemprop="url" content="{{.SiteURL}}/">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
        <div class="shell header-inner">
            <a class="brand" href="/" aria-label="WeekScale home">
                <img src="/static/img/weekscale-mark.svg?version={{.Version}}" width="42" height="42" alt="">
                <span>WeekScale</span>
            </a>
            {{template "partial:nav" .}}
        </div>
    </header>
    <main id="main-content">
        {{template "page:main" .}}
    </main>
    {{template "partial:footer" .}}
</body>
</html>
{{end}}
